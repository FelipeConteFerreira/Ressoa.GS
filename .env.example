# Copie para .env e preencha. O .env NÃO vai para o Git.
# Variáveis EXPO_PUBLIC_ ficam embutidas no app: coloque só URLs, nunca senhas ou chaves.

# API principal (Java / Spring Boot), sem barra no final
EXPO_PUBLIC_JAVA_API_URL=http://localhost:8080

# API de telemetria (.NET), sem barra no final
EXPO_PUBLIC_DOTNET_API_URL=http://localhost:5000

# true = usa a API simulada em memória (src/services/mock) enquanto o backend não sobe.
# Deixe false antes de gerar o build publicado.
EXPO_PUBLIC_USE_MOCK=true
