{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_JAVA_API_URL": "https://ressoa-api-java.onrender.com",
        "EXPO_PUBLIC_DOTNET_API_URL": "https://ressoa-api-dotnet.onrender.com",
        "EXPO_PUBLIC_USE_MOCK": "false"
      }
    },
    "production": {}
  }
}
